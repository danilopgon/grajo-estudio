# Environment variables for Grajo Estudio
# Copy this file to .env.local and fill in the values
# .env.local is gitignored and should never be committed

NEXT_PUBLIC_SITE_URL=https://grajoestudio.com

# ── SMTP — Nodemailer (contact form) ────────────────────────
# Gmail example: host=smtp.gmail.com, port=587, secure=false
# Use an App Password if 2FA is enabled on Gmail.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hola@grajoestudio.com
SMTP_PASS=your-smtp-password-here

# Recipient for contact form submissions (defaults to SMTP_USER if unset)
CONTACT_TO=hola@grajoestudio.com
